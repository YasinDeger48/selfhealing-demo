<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example test project for the ShopLab demo site. It uses the self-healing framework exactly like
  any other project would: as ordinary Maven dependencies (healer-playwright + optional healer-claude).
  Until the framework is published, install it locally first: `mvn install` in ../healing-framework.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.shoplab</groupId>
  <artifactId>shoplab-tests</artifactId>
  <version>1.0.0</version>
  <name>ShopLab UI tests</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <healer.version>2.0.0</healer.version>
    <junit.version>5.14.4</junit.version>
    <shoplab.baseUrl>http://localhost:8080</shoplab.baseUrl>
    <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
    <bench.llm>false</bench.llm>
  </properties>

  <dependencies>
    <!-- Self-healing locators for Playwright + JUnit 5 extension -->
    <dependency>
      <groupId>com.selfhealing</groupId>
      <artifactId>healer-playwright</artifactId>
      <version>${healer.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Optional: Claude as the last healing stage (needs ANTHROPIC_API_KEY) -->
    <dependency>
      <groupId>com.selfhealing</groupId>
      <artifactId>healer-claude</artifactId>
      <version>${healer.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.20</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
          <systemPropertyVariables>
            <shoplab.baseUrl>${shoplab.baseUrl}</shoplab.baseUrl>
            <!-- same id for every forked JVM of this build: their results are merged into one report -->
            <healer.runId>${maven.build.timestamp}</healer.runId>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- Tests use the installed Edge (browser.channel=msedge); no browser download needed -->
            <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
          </environmentVariables>
        </configuration>
      </plugin>
      <!-- Healing accuracy benchmark on the ShopLab pages: mvn exec:java@benchmark (add -Dbench.llm=true for Claude) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>benchmark</id>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.selfhealing.healer.playwright.HealingBenchmark</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>--url</argument><argument>${shoplab.baseUrl}/products</argument>
                <argument>--url</argument><argument>${shoplab.baseUrl}/products/4</argument>
                <argument>--url</argument><argument>${shoplab.baseUrl}/cart</argument>
                <argument>--url</argument><argument>${shoplab.baseUrl}/contact</argument>
                <argument>--storage-state</argument><argument>benchmark/shoplab-state.json</argument>
                <argument>--llm</argument><argument>${bench.llm}</argument>
                <argument>--set</argument><argument>healer.llm.escalateTo=</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
