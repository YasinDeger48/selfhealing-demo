<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cucumber + Playwright tests for the public TripForge self-healing lab, using the framework straight from
  Maven Central (io.github.yasindeger48). Nothing has to be built or installed first.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.tripforge</groupId>
  <artifactId>tripforge-cucumber-tests</artifactId>
  <version>1.0.0</version>
  <name>TripForge self-healing lab - Cucumber</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <healer.version>2.2.0</healer.version>
    <cucumber.version>7.34.9</cucumber.version>
    <junit.version>5.14.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Self-healing locators for Playwright -->
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-playwright</artifactId>
      <version>${healer.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Cucumber plugin: scenarios and Gherkin steps in the report, failure analysis -->
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-cucumber</artifactId>
      <version>${healer.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Optional: Claude as the last healing stage (needs ANTHROPIC_API_KEY) -->
    <dependency>
      <groupId>io.github.yasindeger48</groupId>
      <artifactId>healer-claude</artifactId>
      <version>${healer.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- constructor injection: the hooks and step classes share one World per scenario -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.20</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
          <systemPropertyVariables>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- uses the installed Edge (browser.channel=msedge); no browser download -->
            <PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>1</PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
